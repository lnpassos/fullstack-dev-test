# Copy to `.env` and fill in. `.env` is gitignored; never commit a real key.
#   cp .env.example .env

# --- Runtime ------------------------------------------------------------
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# --- LLM provider -------------------------------------------------------
# `gemini` calls Google AI Studio. `fake` is a deterministic in-process
# provider: no key, no network, useful for demos, offline work and CI.
LLM_PROVIDER=gemini

# Get one at https://aistudio.google.com/apikey (free tier is enough).
# Required only when LLM_PROVIDER=gemini.
GEMINI_API_KEY=
# Lite is the right size for this task: three short greetings need no
# reasoning, and it is markedly cheaper and faster than full Flash.
GEMINI_MODEL=gemini-flash-lite-latest
# Reasoning-token allowance. Leave unset for models that do not reason (the
# default) — they reject the field with 400. Set to 0 if you point GEMINI_MODEL
# at a reasoning model such as gemini-flash-latest, where reasoning tokens are
# billed and drawn from the same budget as the answer.
# GEMINI_THINKING_BUDGET=0

# --- Resilience ---------------------------------------------------------
# Deadline for a single provider call. Past this the request degrades to the
# curated fallback rather than holding the client's spinner open.
LLM_TIMEOUT_MS=8000
# Retries for transient failures only (timeout, 429, 5xx, network).
LLM_MAX_RETRIES=2
# Deadline for the whole request, across every attempt. This is the number a
# user feels: without it the worst case is (retries + 1) x LLM_TIMEOUT_MS.
#
# The defaults assume a healthy provider — Gemini Flash Lite answers this prompt
# in about 1-2s when it is not busy. The free tier is not always healthy: under
# load it returns 503, or takes 20-30s to answer at all. With these defaults
# every request then degrades to the curated fallback, which is correct
# behaviour and a useless demo.
#
# If your key is on the free tier and you are seeing the "standard messages"
# notice, raise both:
#
#   LLM_TIMEOUT_MS=30000
#   LLM_TOTAL_BUDGET_MS=45000
#
# Do not ship those numbers. A person buying a gift card will not wait 45
# seconds; on a paid tier the defaults are the right trade-off.
LLM_TOTAL_BUDGET_MS=12000
# Consecutive failures that open the circuit, and how long it stays open.
BREAKER_FAILURE_THRESHOLD=5
BREAKER_RESET_MS=30000

# --- Cost controls ------------------------------------------------------
CACHE_ENABLED=true
CACHE_TTL_MS=3600000
CACHE_MAX_ENTRIES=500

RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20

# --- Network ------------------------------------------------------------
# Comma-separated origins. `*` is for local development only; set the real
# origins in any deployed environment.
CORS_ORIGINS=*
# Number of reverse proxies in front of this process. 0 = directly exposed.
# Too high lets a client forge X-Forwarded-For and bypass the rate limit.
TRUST_PROXY=0
