<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only.

  Android has blocked plaintext HTTP by default since API 28, so a debug build
  talking to a backend on `http://10.0.2.2:8080` fails at the socket with no
  useful message — the app reports "could not reach the server" and the cause
  looks nothing like a platform policy.

  This permits cleartext for the loopback addresses a local backend uses, and
  nothing else. The blanket alternative, `android:usesCleartextTraffic="true"`,
  would allow it for every host the app ever talks to.

  It lives under `src/debug/`, so it is merged into debug builds and is absent
  from release ones. A release build cannot reach a plaintext host at all, which
  is the correct default for an app that will talk to HTTPS in production.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- The host machine, as seen from the Android emulator. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- A backend running on the device itself, or reached over adb reverse. -->
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
